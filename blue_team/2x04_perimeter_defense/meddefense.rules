alert tcp 10.10.4.0/24 any -> !$HOME_NET any (msg:"MEDDEFENSE MEDDEV TCP to Internet"; classtype:policy-violation; sid:9000001; rev:1;)
alert udp 10.10.4.0/24 any -> !$HOME_NET !123 (msg:"MEDDEFENSE MEDDEV UDP to Internet"; classtype:policy-violation; sid:9000007; rev:1;)
alert tcp 10.10.5.0/24 any -> $HOME_NET 445 (msg:"MEDDEFENSE Unauthorized SMB from Guest"; flow:to_server; classtype:policy-violation; sid:9000002; rev:1;)
alert tcp 10.10.1.0/24 any -> !$HOME_NET any (msg:"MEDDEFENSE Large Outbound From Server"; flow:established,to_server; stream_size:client,>,52428800; threshold:type limit,track by_src,count 1,seconds 300; classtype:policy-violation; sid:9000003; rev:1;)
alert dns any any -> any any (msg:"MEDDEFENSE DNS Long Leftmost Label"; dns.query; pcre:"/^[^.]{51,}\./"; classtype:policy-violation; sid:9000004; rev:1;)
alert tcp 10.10.2.0/24 any -> !$BILLING_DB 3306 (msg:"MEDDEFENSE Clinical Workstation Unauthorized Database"; flow:to_server; classtype:policy-violation; sid:9000005; rev:1;)
alert tcp any any -> 10.10.4.0/24 23 (msg:"MEDDEFENSE Telnet to Medical Device"; flow:to_server; classtype:policy-violation; sid:9000006; rev:1;)
