    "jq -s 'add | unique_by([.event_id,.value])' \"$TMPDIR/ip_ioc_matches.json\" \"$TMPDIR/explicit_ioc_matches.json\"",
    "jq 'length' \"$TMPDIR/ioc_matches.json\"",
    "jq -r 'map(.value) | unique | join(\", \")' \"$TMPDIR/ioc_matches.json\"",
    "jq --argjson hosts \"$hosts\" '...select incident hosts from deviation_markers...' \"$BASELINE_FILE\"",
    "jq 'length' \"$TMPDIR/deviations.json\"",
    "jq -r '.[] | \"HOST: MARKER observed=VALUE reference=REFERENCE\"' \"$TMPDIR/deviations.json\"",
    "jq -r 'map((.event_category // \"\") + \" \" + (.raw_message // \"\") + \" \" + (.event.rule_id // .event.rule // \"\")) | join(\" \") | ascii_downcase' \"$TMPDIR/top6.json\"",
    "jq -r '.[].event_id' \"$TMPDIR/top6.json\"",
    "jq --rawfile actions \"$ACTIONS_FILE\" --rawfile event_refs \"$TMPDIR/event_refs.txt\" '...build locked finding...' \"$TMPDIR/incident_A.json\"",
    "jq -e '...validate locked finding schema...' \"$OUTPUT\"",
    "jq '.event_refs | length' \"$OUTPUT\"",
    "jq '.attack_techniques | length' \"$OUTPUT\""
